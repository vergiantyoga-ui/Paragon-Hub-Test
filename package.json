{
  "name": "paragon-supplier-hub",
  "private": true,
  "version": "2.0.0",
  "description": "Paragon Supply Collaboration Hub — front-end React, API Express, basis data SQLite",
  "type": "module",
  "engines": { "node": ">=18.17" },
  "workspaces": ["frontend", "backend"],
  "scripts": {
    "setup": "npm install && npm run db:reset",
    "dev": "node scripts/dev.mjs",
    "dev:frontend": "npm run dev --workspace frontend",
    "dev:backend": "npm run dev --workspace backend",
    "build": "npm run build --workspace frontend",
    "start": "npm run start --workspace backend",
    "db:migrate": "npm run migrate --workspace backend",
    "db:seed": "npm run seed --workspace backend",
    "db:reset": "npm run reset --workspace backend",
    "test": "node scripts/test.mjs",
    "test:frontend": "npm test --workspace frontend",
    "test:backend": "npm test --workspace backend"
  }
}
